<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <style name="Status_Text" >
      <item name="android:autoSizeMinTextSize">1dp</item>
      <item name="android:textColor">@color/Gainsboro</item>
      <item name="android:layout_height">match_parent</item>
      <item name="android:layout_width">match_parent</item>
      <item name="android:autoSizeTextType">uniform</item>
      <item name="android:gravity">center</item>
      <item name="android:textAlignment">gravity</item>
      <item name="android:layout_marginTop">3dp</item>
      <item name="android:layout_marginRight">3dp</item>
      <item name="android:layout_marginLeft">3dp</item>
      <item name="android:layout_marginBottom">3dp</item>
    </style>
    <style name="Arrival_TimespanColumn" >
      <item name="android:autoSizeMinTextSize">1dp</item>
      <item name="android:textColor">@android:color/black</item>
      <item name="android:layout_height">match_parent</item>
      <item name="android:layout_width">0dp</item>
      <item name="android:autoSizeTextType">uniform</item>
      <item name="android:gravity">center_vertical|right</item>
      <item name="android:textAlignment">gravity</item>
      <item name="android:layout_columnWeight">1</item>
      <item name="android:layout_marginRight">3dp</item>
    </style>
  <style name="Arrival_DatetimeColumn" >
    <item name="android:autoSizeMinTextSize">1dp</item>
    <item name="android:textColor">@android:color/black</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:autoSizeTextType">uniform</item>
    <item name="android:gravity">center</item>
    <item name="android:textAlignment">gravity</item>
    <item name="android:layout_columnWeight">1</item>
  </style>
  <style name="Arrival_TextColumn" >
    <item name="android:autoSizeMinTextSize">1dp</item>
    <item name="android:textColor">@android:color/black</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:autoSizeTextType">uniform</item>
    <item name="android:gravity">center_vertical|left</item>
    <item name="android:textAlignment">gravity</item>
    <item name="android:layout_marginLeft">3dp</item>
    <item name="android:layout_columnWeight">1</item>
  </style>
  <style name="JobInfo_Text" >
    <item name="android:autoSizeMinTextSize">1dp</item>
    <item name="android:textColor">@android:color/black</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">0dp</item>
    <item name="android:autoSizeTextType">uniform</item>
    <item name="android:layout_rowWeight">1</item>
    <item name="android:gravity">center_vertical|left</item>
    <item name="android:textAlignment">gravity</item>
    <item name="android:layout_marginLeft">3dp</item>
    <item name="android:layout_marginRight">3dp</item>
  </style>
  <style name="MiscInfo_Text" >
    <item name="android:autoSizeMinTextSize">1dp</item>
    <item name="android:textColor">@android:color/black</item>
    <item name="android:layout_height">0dp</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:autoSizeTextType">uniform</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:layout_columnWeight">1</item>
    <item name="android:layout_rowWeight">1</item>
    <item name="android:textAlignment">gravity</item>
  </style>
</resources>