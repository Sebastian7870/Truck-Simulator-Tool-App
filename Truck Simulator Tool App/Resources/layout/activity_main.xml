<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingDimension" >

    <GridLayout
        android:layout_weight="80"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:columnCount="5"
        android:id="@+id/gridLayout1">
        <TextView
            style="@style/Status_Text"
            android:text="Keine Verbindung zum Server" />
        <Space
            android:layout_width="0dp"
            android:layout_columnWeight="0.007"
            android:layout_height="match_parent"
            android:background="@android:color/white"/>   
        <TextView
            style="@style/Status_Text"
            android:text="Keinen aktiven Auftrag" />
        <Space
            android:layout_width="0dp"
            android:layout_columnWeight="0.007"
            android:layout_height="match_parent"
            android:background="@android:color/white"/>  
        <TextView
            style="@style/Status_Text"
            android:text="Keine Schicht geladen" />
    </GridLayout>
     
    <GridLayout
        android:layout_marginTop="30dp"
        android:layout_weight="80"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:columnCount="3"
        android:rowCount="3"
        android:id="@+id/gridLayout2">
            <TextView
                style="@style/Arrival_TextColumn"
                android:text="Ankunft ca.:" />
            <TextView
                style="@style/Arrival_DatetimeColumn"
                android:text="00:00 Uhr" />
            <TextView
                style="@style/Arrival_TimespanColumn"
                android:text="(0 Min.)" />

            <TextView
                style="@style/Arrival_TextColumn"
                android:text="Beste Ankunft:" />
            <TextView
                style="@style/Arrival_DatetimeColumn"
                android:text="00:00 Uhr" />
            <TextView
                style="@style/Arrival_TimespanColumn"
                android:text="(0 Min.)" />

            <TextView
                style="@style/Arrival_TextColumn"
                android:text="Geplante Ankunft:" />
            <TextView
                style="@style/Arrival_DatetimeColumn"
                android:text="00:00 Uhr" />
            <TextView
                style="@style/Arrival_TimespanColumn"
                android:text="(0 Min.)" />
    </GridLayout>

    <GridLayout
        android:layout_marginTop="30dp"
        android:layout_weight="260"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:rowCount="7"
        android:columnCount="1"
        android:id="@+id/linearLayout1">
        <TextView
            android:textColor="@android:color/black"
            android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_rowWeight="50"
            android:background="#c7c7c7"
            android:gravity="center"
            android:textAlignment="gravity"
            android:textSize="20dp"
            android:text="Auftragsinformationen"/>
        <TextView
            style="@style/JobInfo_Text"
            android:text="Pause in:"/>
        <TextView
            style="@style/JobInfo_Text"
            android:text="Restzeit:"/>
        <TextView
            style="@style/JobInfo_Text"
            android:text="Leerfahrt"/>
        <TextView
            style="@style/JobInfo_Text"
            android:text="0 t"/>
        <TextView
            style="@style/JobInfo_Text"
            android:text="0€ (0 €/km)"/>
        <ImageView
            android:id="@+id/imageView1"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_rowWeight="18"
            android:background="@android:color/holo_red_dark"/>
    </GridLayout>

    <GridLayout
        android:layout_marginTop="30dp"
        android:layout_weight="120"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:rowCount="3"
        android:columnCount="1">
        <GridLayout
            android:layout_rowWeight="50"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:rowCount="2"
            android:columnCount="2">
            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|left"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Upon Newcastle"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|right"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Upon Newcastle"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|left"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Eurogoodies"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|right"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Transinet"/>
            
        </GridLayout>
        <ImageView
            android:id="@+id/imageView1"   
            android:layout_width="match_parent"
            android:layout_height="0dp" 
            android:background="@android:color/holo_green_light"
            android:layout_rowWeight="23" />
        <GridLayout
            android:layout_rowWeight="20"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:rowCount="1"
            android:columnCount="5">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_columnWeight="25"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|left"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="0,00%"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_columnWeight="50"
                android:background="@android:color/holo_red_dark"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Zeitpuffer: 0 Min."/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_columnWeight="25"
                android:textColor="@android:color/black"
                android:gravity="center_vertical|right"
                android:textAlignment="gravity"
                android:autoSizeTextType="uniform"
                android:text="Noch 0 km" />
        </GridLayout>
    </GridLayout>
    
    <GridLayout
        android:layout_marginTop="20dp" 
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="20"
    android:background="#C9C9C9"
    android:rowCount="4"
    android:columnCount="1">
    <TextView
        style="@style/MiscInfo_Text"
        android:text="Nächstes Schichtereignis: [Schichtbeginn]   22:00 Uhr, Dienstag" />
    <TextView
        style="@style/MiscInfo_Text"
        android:text="" />
    <TextView
        style="@style/MiscInfo_Text"
        android:text="" />
    <TextView
        style="@style/MiscInfo_Text"
        android:text="" />
    </GridLayout>
        
     
</LinearLayout>